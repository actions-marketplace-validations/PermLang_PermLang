{
  "name": "permlang",
  "version": "0.4.3",
  "description": "Build-time permission checker for TypeScript and AI agents. Fails the pull request when code starts reaching a new server, file, secret, database table, or CI permission, and flags risky MCP and other AI tools.",
  "keywords": [
    "permissions",
    "capabilities",
    "least-privilege",
    "static-analysis",
    "sast",
    "security-scanner",
    "typescript",
    "security",
    "devsecops",
    "code-review",
    "ai-generated-code",
    "ai-agents",
    "ai-security",
    "llm-security",
    "prompt-injection",
    "mcp",
    "model-context-protocol",
    "github-action",
    "github-actions",
    "supply-chain-security",
    "lint"
  ],
  "homepage": "https://github.com/PermLang/PermLang#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PermLang/PermLang.git"
  },
  "bugs": {
    "url": "https://github.com/PermLang/PermLang/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "permlang": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "adapters",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.1"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "permlang": "tsx src/cli.ts",
    "permlang:released": "node scripts/permlang-released.mjs",
    "sbom": "node scripts/sbom.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ts-morph": "^27.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
