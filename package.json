{
  "name": "permlang",
  "version": "0.3.1",
  "description": "The permission diff for AI-written TypeScript. Declare what each function can touch; the build fails when code exceeds it.",
  "keywords": [
    "permissions",
    "capabilities",
    "static-analysis",
    "typescript",
    "security",
    "code-review",
    "ai-generated-code",
    "ai-agents",
    "mcp",
    "github-actions",
    "supply-chain-security",
    "lint"
  ],
  "homepage": "https://github.com/PermLang/permlang#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PermLang/permlang.git"
  },
  "bugs": {
    "url": "https://github.com/PermLang/permlang/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "permlang": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "adapters",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "permlang": "tsx src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ts-morph": "^27.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
