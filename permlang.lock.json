{
  "permlang": 1,
  "functions": {
    ".github/workflows/ci.yml#<ci.yml>": [
      "ci.action(actions/checkout)",
      "ci.action(actions/setup-node)",
      "ci.action(codecov/codecov-action)",
      "ci.permission(contents: read)",
      "ci.permission(id-token: write)",
      "ci.trigger(pull_request)",
      "ci.trigger(push)"
    ],
    ".github/workflows/permlang.yml#<permlang.yml>": [
      "ci.action(./)",
      "ci.action(actions/checkout)",
      "ci.permission(contents: read)",
      "ci.permission(pull-requests: write)",
      "ci.permission(security-events: write)",
      "ci.trigger(pull_request)",
      "ci.trigger(push)"
    ],
    ".github/workflows/release.yml#<release.yml>": [
      "ci.action(actions/attest)",
      "ci.action(actions/checkout)",
      "ci.action(actions/download-artifact)",
      "ci.action(actions/setup-node)",
      "ci.action(actions/upload-artifact)",
      "ci.permission(attestations: write)",
      "ci.permission(contents: read)",
      "ci.permission(contents: write)",
      "ci.permission(id-token: write)",
      "ci.trigger(release)"
    ],
    ".github/workflows/scorecard.yml#<scorecard.yml>": [
      "ci.action(actions/checkout)",
      "ci.action(ossf/scorecard-action)",
      "ci.permission(actions: read)",
      "ci.permission(contents: read)",
      "ci.permission(id-token: write)",
      "ci.trigger(push)",
      "ci.trigger(schedule)",
      "ci.trigger(workflow_dispatch)"
    ],
    "action.yml#<action.yml>": [
      "ci.action(actions/cache/restore)",
      "ci.action(actions/cache/save)",
      "ci.action(actions/setup-node)",
      "ci.action(github/codeql-action/upload-sarif)"
    ],
    "package.json#<package.json>": [
      "npm.script(build: node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json)",
      "npm.script(permlang: tsx src/cli.ts)",
      "npm.script(prepublishOnly: npm run typecheck && npm test && npm run build)",
      "npm.script(test: vitest run)",
      "npm.script(test:coverage: vitest run --coverage)",
      "npm.script(test:watch: vitest)",
      "npm.script(typecheck: tsc --noEmit)"
    ],
    "src/adapters.ts#builtinAdapterPaths": [
      "fs.read"
    ],
    "src/adapters.ts#loadAdapters": [
      "fs.read"
    ],
    "src/check.ts#checkFiles": [
      "fs.read"
    ],
    "src/check.ts#checkProject": [
      "fs.read"
    ],
    "src/check.ts#checkTsConfig": [
      "fs.read"
    ],
    "src/cli.ts#<module>": [
      "env(GITHUB_WORKSPACE)",
      "exec",
      "fs.read",
      "fs.read(package.json)",
      "fs.read(permlang.config.json)",
      "fs.read(tsconfig.json)",
      "fs.write"
    ],
    "src/main.ts#analyze": [
      "fs.read",
      "fs.read(permlang.config.json)",
      "fs.read(tsconfig.json)"
    ],
    "src/main.ts#check": [
      "env(GITHUB_WORKSPACE)",
      "fs.read",
      "fs.read(permlang.config.json)",
      "fs.read(tsconfig.json)",
      "fs.write"
    ],
    "src/main.ts#defaultBranch": [
      "exec"
    ],
    "src/main.ts#dependencyChanges": [
      "exec",
      "fs.read",
      "fs.read(package.json)",
      "fs.read(permlang.config.json)"
    ],
    "src/main.ts#diff": [
      "exec",
      "fs.read",
      "fs.read(package.json)",
      "fs.read(permlang.config.json)",
      "fs.read(tsconfig.json)"
    ],
    "src/main.ts#expand": [
      "fs.read"
    ],
    "src/main.ts#fileAt": [
      "exec"
    ],
    "src/main.ts#findSpecFiles": [
      "fs.read"
    ],
    "src/main.ts#gitRoot": [
      "exec",
      "fs.write"
    ],
    "src/main.ts#init": [
      "exec",
      "fs.read",
      "fs.read(permlang.config.json)",
      "fs.read(tsconfig.json)",
      "fs.write"
    ],
    "src/main.ts#installSteps": [
      "fs.read"
    ],
    "src/main.ts#installed": [
      "fs.read"
    ],
    "src/main.ts#lock": [
      "fs.read",
      "fs.read(permlang.config.json)",
      "fs.read(tsconfig.json)",
      "fs.write"
    ],
    "src/main.ts#lockAt": [
      "exec"
    ],
    "src/main.ts#main": [
      "env(GITHUB_WORKSPACE)",
      "exec",
      "fs.read",
      "fs.read(package.json)",
      "fs.read(permlang.config.json)",
      "fs.read(tsconfig.json)",
      "fs.write"
    ],
    "src/main.ts#packageVersion": [
      "fs.read"
    ],
    "src/main.ts#readConfig": [
      "fs.read",
      "fs.read(permlang.config.json)"
    ],
    "src/main.ts#spec": [
      "fs.read",
      "fs.read(permlang.config.json)",
      "fs.read(tsconfig.json)"
    ],
    "src/main.ts#workflowFile": [
      "exec",
      "fs.read"
    ],
    "src/main.ts#workflowTarget": [
      "exec",
      "fs.write"
    ],
    "src/project-files.ts#listFiles": [
      "fs.read"
    ],
    "src/project-files.ts#packageEntry": [
      "fs.read"
    ],
    "src/project-files.ts#projectFiles": [
      "fs.read"
    ],
    "src/project-files.ts#yamlEntry": [
      "fs.read"
    ],
    "src/spec/parse.ts#parseSpecs": [
      "fs.read"
    ]
  },
  "unsafe": {}
}
